{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@volttrade/shared": ["../../packages/shared/src/index.ts"],
      "@volttrade/blockchain": ["../../packages/blockchain/src/index.ts"],
      "@volttrade/database": ["../../packages/database/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
